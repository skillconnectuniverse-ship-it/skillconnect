# Server
PORT=4000
NODE_ENV=development
# Public URL of this backend (used for payment pages/callbacks). Must be reachable from phones.
PUBLIC_URL=http://localhost:4000
# Comma separated web origins allowed by CORS, or * for all
CORS_ORIGINS=*

# Cloud database (MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/skillconnect

# Auth (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# Platform commission taken from each booking (percent)
PLATFORM_FEE_PERCENT=10

# Razorpay (INR payments: UPI QR, debit/credit cards, netbanking, wallets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (international cards, other currencies)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Image storage in the cloud (Cloudinary). If empty, files are stored on local disk (dev only).
CLOUDINARY_URL=

# Dev only: lets you test the whole hire flow without real gateway keys. NEVER enable in production.
ALLOW_DEMO_PAYMENTS=true

# Encrypts bank/ID details at rest (set once, never change). Falls back to JWT_SECRET.
ENCRYPTION_KEY=

# Email (verification + password reset). Any SMTP: Gmail app password, Brevo, Resend SMTP, SES...
# When SMTP_HOST is set, unverified emails cannot hire (override with REQUIRE_EMAIL_VERIFICATION=false).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SkillConnect <no-reply@yourdomain.com>
REQUIRE_EMAIL_VERIFICATION=

# SMS phone verification (Twilio). Without it, codes are only shown in development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Wallet: hours before earnings can be withdrawn, and the minimum withdrawal (minor units, 10000 = 100.00)
PAYOUT_HOLD_HOURS=24
MIN_PAYOUT_MINOR=10000

# In-app calls: JSON array of ICE servers. Add a TURN server for users behind strict NATs, e.g.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
ICE_SERVERS=
